# Copy to .env.local and fill in.

# --- Database ---
# Local dev uses SQLite by default. No DATABASE_URL needed.
DATABASE_URL="file:./data/local.db"

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="dev-only-not-secure-replace-me"

# NextAuth: where the app lives. Leave default for local.
AUTH_URL="http://localhost:3000"

# --- OAuth providers ---
# Set both ID + SECRET for any provider you want to enable, then uncomment
# the corresponding `import` + `providers: [...]` entry in `src/auth.ts`.
# Auth.js auto-discovers env vars prefixed `AUTH_<PROVIDER>_<ID|SECRET>`.
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""
# AUTH_GITHUB_ID=""
# AUTH_GITHUB_SECRET=""

# --- Verification + reset email transport (Phase 9) ---
# Phase 9 swapped magic-link for username + password — sign-up no longer
# needs email at all. This transport now only powers OPTIONAL flows:
# recovery-email verification (P9.5) and password reset (P9.6). When
# AUTH_RESEND_KEY is unset, both flows print the link to the dev console
# — copy + paste into the browser to verify / reset.
# Set this in production via https://resend.com/api-keys
# AUTH_RESEND_KEY=""
# AUTH_EMAIL_FROM="Mini Mainframe <no-reply@yourdomain.com>"

# --- Stripe billing (subscription paywall) ---
# BILLING_ENFORCED is true (src/lib/billing/plans.ts) — /tools/*, AI, and
# the recipe creator's power features are gated on an active pro_monthly
# subscription. Local dev without these set: checkout returns 503 ("Billing
# is not configured") and the gate dialogs still render, they just can't
# start a real Checkout session.
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."
# The only price actually sold — monthly-only (docs/SUBSCRIPTION_PAYWALL.md).
# Create a $3.99/mo recurring price in Stripe and paste its price id here.
# STRIPE_PRICE_PRO_MONTHLY="price_..."
# Dormant — code paths exist (checkout/webhook both handle them) but nothing
# in the UI surfaces or sells these. Leave unset.
# STRIPE_PRICE_PRO_LIFETIME="price_..."
# STRIPE_PRICE_FOUNDER="price_..."

# --- LLM-assisted import fallback (P7.5) ---
# Required for the messy-list LLM fallback (text parser confidence < 0.6).
# Local dev can leave it unset — the fallback returns a friendly error
# instead of attempting the API call. Get a free key at:
#   https://console.groq.com/keys  (no billing required, 14,400 req/day)
# GROQ_API_KEY=""
