# Copy to .env.local and fill in.

# --- Database ---
# Local dev uses SQLite by default. No DATABASE_URL needed.
DATABASE_URL="file:./data/local.db"

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="dev-only-not-secure-replace-me"

# NextAuth: where the app lives. Leave default for local.
AUTH_URL="http://localhost:3000"

# --- OAuth providers (deferred to Phase 1.5) ---
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""
# AUTH_GITHUB_ID=""
# AUTH_GITHUB_SECRET=""

# --- Magic-link transport (dev: console.log; prod: Resend) ---
# AUTH_RESEND_KEY=""
