# Vercel production environment variables.
# These are set in the Vercel dashboard (Settings → Environment Variables),
# NOT committed. This file is just a template showing the required shape.
#
# Sensitive values come from:
#   DATABASE_URL / DATABASE_AUTH_TOKEN   — Turso dashboard
#   AUTH_RESEND_KEY                       — Resend dashboard
#   AUTH_SECRET                           — generate with:
#       node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Turso (libsql hosted) — drop-in replacement for local file: URL
DATABASE_URL=libsql://<your-db>-<your-org>.turso.io
DATABASE_AUTH_TOKEN=<turso-write-token>

# NextAuth v5
AUTH_SECRET=<32-byte-hex>
AUTH_URL=https://paint-planner-pro.vercel.app

# Magic-link email via Resend
AUTH_RESEND_KEY=<resend-api-key>
# Resend's onboarding domain works without DNS verification but only delivers
# to the email registered on the Resend account. Swap to a custom domain once
# DNS is set up (see DEPLOY.md §6).
AUTH_EMAIL_FROM=Mini Mainframe <onboarding@resend.dev>

# Test-only auth bypass — leave UNSET in production so /api/test/sign-in 404s.
# ALLOW_TEST_AUTH=

# LLM-assisted import fallback (P7.5)
# Required for messy plain-text army lists (text parser confidence < 0.6).
# Without it, the import preview still works for clean lists, PDFs, and
# .ros/.rosz files — only the messy-text fallback path errors out.
# Free key at https://console.groq.com/keys (no billing required).
GROQ_API_KEY=<groq-api-key>
